# Copy to .env (never commit .env).
# Each LLM step is provider:model. Providers: openrouter | openai_compatible | fake (offline, no key)
LLM_EXTRACT=openrouter:deepseek/deepseek-v4-flash
LLM_DRAFT=fake:template
# Extract default chosen on pilot (100%) + holdout (99.4% top-1), prompt extract-v2. fake:keywords = offline, no key.
LLM_EXTRACT_JSON_MODE=json_schema
LLM_DRAFT_JSON_MODE=prompt
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_S=30
LLM_CACHE_PATH=backend/.cache/llm_cache.db
USD_TO_MYR=4.20

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional second provider: any OpenAI-compatible endpoint
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

DB_PATH=backend/teratai.db
INBOX_DIR=inbox
TEAM_NAME=teratai-team
